pipeline {

    agent any

    tools {
        nodejs 'node18'
    }

    environment {
        AWS_REGION = 'us-east-1'
        ECR_REPOSITORY = 'zomato'
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Git Checkout') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/revathy3006/Zomato.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Build Application') {
            steps {
                sh 'npm run build'
            }
        }

        stage('Trivy File Scan') {
            steps {
                sh 'trivy fs . > trivy-fs-report.txt'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t ${ECR_REPOSITORY}:${IMAGE_TAG} .'
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh 'trivy image ${ECR_REPOSITORY}:${IMAGE_TAG} > trivy-image-report.txt'
            }
        }

        stage('Push Image to ECR') {
            steps {
                sh '''
                    AWS_ACCOUNT_ID=$(aws sts get-caller-identity \
                        --query Account \
                        --output text)

                    ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

                    aws ecr get-login-password \
                        --region ${AWS_REGION} | \
                    docker login \
                        --username AWS \
                        --password-stdin ${ECR_REGISTRY}

                    docker tag \
                        ${ECR_REPOSITORY}:${IMAGE_TAG} \
                        ${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}

                    docker push \
                        ${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}
                '''
            }
        }

        stage('Deploy to EKS Staging') {
            steps {
                sh '''
                    # Create staging namespace if it does not exist
                    kubectl create namespace staging \
                        --dry-run=client \
                        -o yaml | kubectl apply -f -

                    # Get ECR registry
                    AWS_ACCOUNT_ID=$(aws sts get-caller-identity \
                        --query Account \
                        --output text)

                    ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

                    # Replace image placeholder with current Jenkins build image
                    sed -i "s|IMAGE_PLACEHOLDER|${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}|g" \
                        Kubernetes/deployment.yml

                    # Deploy Zomato
                    kubectl apply -f Kubernetes/deployment.yml
                    kubectl apply -f Kubernetes/service.yml

                    # Create monitoring namespaces
                    kubectl apply -f monitoring/namespace.yml
                    kubectl apply -f monitoring/node-exporter-namespace.yml

                    # Deploy Prometheus
                    kubectl apply -f monitoring/prometheus-rbac.yml
                    kubectl apply -f monitoring/prometheus-config.yml
                    kubectl apply -f monitoring/prometheus-deployment.yml
                    kubectl apply -f monitoring/prometheus-service.yml

                    # Deploy Node Exporter
                    kubectl apply -f monitoring/node-exporter-daemonset.yml

                    # Deploy Grafana
                    kubectl apply -f monitoring/grafana-datasource.yml
                    kubectl apply -f monitoring/grafana-deployment.yml
                    kubectl apply -f monitoring/grafana-service.yml
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'trivy-fs-report.txt, trivy-image-report.txt',
                             allowEmptyArchive: true
        }
    }
}
